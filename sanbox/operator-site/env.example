# sanbox/operator-site — העתק ל-.env.local (git-ignored) לפני עריכת-ערכים
# אסור לעשות commit לקובץ עם ערכים אמיתיים.

PORT=3046
HOST=127.0.0.1
# חלון-אתחול-סיסמה מעלייה (דקות) — אחריו השער נעול עד אתחול-ידני
SETUP_WINDOW_MIN=20
# תוקף-סשן (שעות)
SESSION_TTL_H=12

# אתחול-headless בלבד (סוכנים; עדיף: setup דרך הדפדפן):
# OPERATOR_BOOTSTRAP_PASSWORD=...   ← לעולם לא commit. bash auth/gen-hash.sh
