:81 {
	# FIX(Roast-63 · HIGH): וויטליסט-פורטים — היה-פרוקסי-פתוח-לכל-פורט-מקומי
	# (כל-מי-שמגיע-ל:81 יכול-היה-לתחקר-כל-שירות-על-המארח). עכשיו: רק-השירותים-הלגיטימיים:
	# 3010 = DEX-דמון · 3003 = relay-socket.io. כל-XTransformPort-אחר → 403.
	@port_dex query XTransformPort=3010
	@port_relay query XTransformPort=3003
	@port_other query XTransformPort=*

	handle @port_dex {
		reverse_proxy localhost:3010 {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}

	handle @port_relay {
		reverse_proxy localhost:3003 {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}

	handle @port_other {
		respond 403
	}

	handle {
		reverse_proxy localhost:3000 {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}
}
