# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/tool-results/

# secrets — never commit
upload/
.secrets/
tool-results/

# SAOS R220: pid/log files are runtime state, not source — no more sweep churn
*.pid

# R241 hygiene: local env + live database are runtime state, not source
.env
db/*.db

# exception: example env is source, not secret
!.env.example
agent/keys/wallets-seed.json
agent/keys/wallets-registry.json

# runner junk (measured 2026-10-11, saos-runtime run 249): `npm i --no-save`
# still writes package-lock.json; the engine's canonical lock is bun.lock. A
# stray untracked lockfile must never block a rebase during a push race.
package-lock.json
scout-state/

# secrets — local key slots (never commit)
mini-services/saos-engine/keys.env
mini-services/saos-engine/.env
.env.local

# R319 custody law: plaintext secrets never in git (vault=GEN-3; plaintext=private coordination)
.secrets/
upload/pat.env
