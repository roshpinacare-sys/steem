# 117p — keys FULLY OUT of the repo (operator directive): fleet seal is local-only now.
# Disaster recovery = agent/vault/KEYS-BACKUP-*.tar.enc (operator password, chat-only) + THE-GATE paste.
agent/fleet_keys.enc
agent/fleet_keys.meta.json

# 117p5 — repo slimming: research dumps + repo-snapshots stay LOCAL-ONLY (git never carries
# extracted archives / npm caches / recursive repo copies again; ~250MB of tracked bloat removed).
# KEPT TRACKED: agent/vault/KEYS-BACKUP-*.tar.enc + README — the disaster-recovery lifeline.
download/research/
download/recovery/
download/task26-pre-restore-backup.tar.gz

# 117p5 — chain-archive separation: the live jsonl grows ~1.8MB/30min (~86MB/day) and gitkeeper
# used to carry a FULL new blob every loop. Survival now travels as the compressed seal
# (chain-archive-seal.jsonl.gz + seal-state, tracked); restore-after-wipe is automatic
# (sovereign/node/seal_archive.cjs, hooked into gitkeeper step 0b).
sovereign/node/chain-archive.jsonl

# 117p6 — runtime pid files: never track (churn noise every restart)
*.pid
agent/ROGUE-SEED-BLOCKED.json

# 117p8-R14 — keyszip auto-refresh runtime state (churn noise)
agent/.keyszip-refresh.json

# R18d — ארכיון-הסגר-של-השרשרת: צומח-מעל-מגבלת-100MB-של-גיטהאב · נשאר-מקומי-בלבד
sovereign/node/chain-archive-fork-quarantine.jsonl

# ── 2026-09 hygiene (Task 7-c): live signing-event logs are RUNTIME STATE ──
# mini-services/key-broker/audit.jsonl (13 real signing events, 2026-09-08/09)
# was untracked from git (history kept, local file kept). Signing-event logs must
# never be versioned again; private key material must never reach evidence at all.
agent/**/audit.jsonl
mini-services/**/audit.jsonl

# Z-21 — plaintext key-drop folder removed from git (security doctrine)
nvx/

# custody-hygiene (V-a 2d9dd6e9): nv.zip untracked from the live tree — recovery preserved via
# agent/vault/*.enc + agent/recovery-meta.json + FACTORY_MASTER derivation; history untouched.
# Keep it out of accidental re-adds (git add .); recovery material lives in the vault chain, not here.
nv.zip
