  "components": {
    "schemas": {
      "APIKeyRequest": {
        "properties": {
          "tenant_id": {
            "type": "string",
            "title": "Tenant Id"
          },
          "identity_id": {
            "type": "string",
            "title": "Identity Id"
          },
          "role": {
            "type": "string",
            "title": "Role",
            "default": "agent"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name",
            "default": ""
          },
          "ttl_seconds": {
            "type": "number",
            "title": "Ttl Seconds",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "tenant_id",
          "identity_id"
        ],
        "title": "APIKeyRequest"
      },
      "APIKeyResponse": {
        "properties": {
          "key_id": {
            "type": "string",
            "title": "Key Id"
          },
          "api_key": {
            "type": "string",
            "title": "Api Key"
          },
          "identity_id": {
            "type": "string",
            "title": "Identity Id"
          },
          "tenant_id": {
            "type": "string",
            "title": "Tenant Id"
          }
        },
        "type": "object",
        "required": [
          "key_id",
          "api_key",
          "identity_id",
          "tenant_id"
        ],
        "title": "APIKeyResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "ok"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "default": "5.1.0"
          },
          "tests_passing": {
            "type": "integer",
            "title": "Tests Passing",
            "default": 421
          },
          "coverage": {
            "type": "string",
            "title": "Coverage",
            "default": "97.4%"
          }
        },
        "type": "object",
        "title": "HealthResponse"
      },
      "MutationRequest": {
        "properties": {
          "mutation_id": {
            "type": "string",
            "title": "Mutation Id"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "risk_class": {
            "type": "string",
            "title": "Risk Class",
            "default": "medium"
          },
          "z3_witness_hash": {
            "type": "string",
            "title": "Z3 Witness Hash"
          },
          "evidence_chain": {
            "additionalProperties": true,
            "type": "object",
            "title": "Evidence Chain"
          },
          "validators": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Validators"
          },
          "seq": {
            "type": "integer",
            "title": "Seq",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "mutation_id",
          "description",
          "z3_witness_hash",
          "evidence_chain"
        ],
        "title": "MutationRequest"
      },
      "MutationResponse": {
        "properties": {
          "mutation_id": {
            "type": "string",
            "title": "Mutation Id"
          },
          "admissible": {
            "type": "boolean",
            "title": "Admissible"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "certified_at": {
            "type": "number",
            "title": "Certified At",
            "default": 0.0
          }
        },
        "type": "object",
        "required": [
          "mutation_id",
          "admissible",
          "reason"
        ],
        "title": "MutationResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}