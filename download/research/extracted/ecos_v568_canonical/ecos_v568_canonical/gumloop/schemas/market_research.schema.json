{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ECOS Growth · Market Research Finding",
  "type": "object",
  "required": [
    "id",
    "type",
    "name",
    "captured_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "dedupe key, e.g. comp_<slug>"
    },
    "type": {
      "enum": [
        "competitor",
        "keyword",
        "trend",
        "funding"
      ]
    },
    "name": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "one_liner": {
      "type": "string"
    },
    "pricing_model": {
      "type": "string"
    },
    "target_audience": {
      "type": "string"
    },
    "maturity": {
      "type": "string"
    },
    "key_message": {
      "type": "string"
    },
    "weakness": {
      "type": "string"
    },
    "search_volume": {
      "type": [
        "integer",
        "null"
      ]
    },
    "source": {
      "type": "string",
      "description": "exa|parallel|firecrawl|semrush"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}