{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ECOS Growth · Generic Event (health/seo/content metrics)",
  "type": "object",
  "required": [
    "id",
    "topic",
    "captured_at",
    "payload"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "topic": {
      "enum": [
        "code_health",
        "seo_audit",
        "content",
        "custom"
      ]
    },
    "ecos_version": {
      "type": "string",
      "description": "e.g. v233"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "description": "topic-specific metrics"
    }
  }
}