{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    "packages/*": {
      "entry": ["src/cli.ts", "src/main.tsx"],
      "project": ["src/**/*.ts", "src/**/*.tsx"],
      "ignore": ["src/**/*.d.ts", "dist/**"]
    }
  },
  "ignore": ["worker/**", "bootstrap.mjs", "bin/**"],
  "ignoreDependencies": ["@types/node", "@types/jsdom", "@types/semver"]
}
