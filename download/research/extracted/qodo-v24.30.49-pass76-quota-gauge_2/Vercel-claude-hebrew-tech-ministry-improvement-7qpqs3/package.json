{
  "name": "qodo",
  "version": "24.30.49",
  "description": "Self-healing, privacy-aware AI agent for autonomous software delivery",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "bin": {
    "create-qodo": "bin/create-qodo.mjs"
  },
  "files": [
    "bin"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "agent": "node packages/agent/dist/cli.js",
    "check:dead-integrations": "node scripts/check-dead-integrations.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:examples": "cd examples/local-simulator && npm install --no-audit --no-fund && npm test"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/semver": "^7.7.1",
    "typescript": "^5.6.2"
  },
  "overrides": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "refractor": {
      "prismjs": "^1.30.0"
    },
    "sharp": "^0.33.5"
  }
}
