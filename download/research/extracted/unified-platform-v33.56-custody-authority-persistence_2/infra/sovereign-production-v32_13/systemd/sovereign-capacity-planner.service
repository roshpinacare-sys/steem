[Unit]
Description=Sovereign capacity proposal planner
After=network-online.target

[Service]
Type=oneshot
User=sovereign
Group=sovereign
WorkingDirectory=/opt/sovereign
ExecStart=/usr/bin/node scripts/plan-sovereign-capacity-v32_13.mjs /etc/sovereign/capacity-snapshot.json /etc/sovereign/capacity-policy.json /etc/sovereign/burst-offers.json /var/lib/sovereign/capacity-plan.json
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sovereign
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
UMask=0077
