{
  "schemaVersion": "32.15",
  "allowedWasiProfiles": ["wasi-0.2", "wasi-0.3"],
  "requireDeterminism": true,
  "requireIndependentReview": true,
  "maximumMemoryBytes": 268435456,
  "maximumExecutionMs": 30000,
  "maximumFuel": 100000000,
  "allowedCapabilities": ["filesystem-read", "network-client", "clock-monotonic", "random-secure"],
  "deniedCapabilities": ["filesystem-write", "network-listen", "process-spawn", "environment-read"],
  "production": true,
  "note": "A repository admission proof does not qualify a concrete runtime. Production requires observed external runtime evidence."
}
