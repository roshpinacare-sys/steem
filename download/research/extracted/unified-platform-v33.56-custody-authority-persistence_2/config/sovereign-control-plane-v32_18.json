{
  "schemaVersion": "32.18",
  "profile": "dapr-spiffe-otel-cloudnativepg-portable-contracts",
  "resiliency": {
    "timeoutsRequired": true,
    "retryRequiresIdempotency": true,
    "maximumAttempts": 10,
    "maximumWorstCaseDurationMs": 600000,
    "circuitBreakerRequired": true,
    "bulkheadRequired": true
  },
  "durableExecution": {
    "hashChainedHistory": true,
    "monotonicSequence": true,
    "exactlyOnceEffectOwnership": true,
    "compensationValidated": true
  },
  "identity": {
    "spiffe": true,
    "nodeAttestation": true,
    "workloadAttestation": true,
    "selectorBinding": true,
    "federationBundleRequiredForForeignTrustDomain": true,
    "shortLivedSvids": true
  },
  "telemetry": {
    "tailSampling": true,
    "preserveErrors": true,
    "preserveSecurityTraces": true,
    "preserveHighLatency": true,
    "tenantMinimum": true,
    "exportBudget": true
  },
  "postgresContinuity": {
    "replicaLagBound": true,
    "synchronousReplicaObservation": true,
    "backupFreshness": true,
    "walArchiveHealth": true,
    "restoreProbe": true,
    "failoverRto": true
  },
  "externalRuntimeStatus": "not_executed",
  "productionPromotion": "blocked"
}
