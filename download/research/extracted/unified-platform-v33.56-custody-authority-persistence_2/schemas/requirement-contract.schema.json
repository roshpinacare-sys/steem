{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sovereign-foundry.example/schemas/requirement-contract.v1.json",
  "title": "Requirement Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["requirementId", "tenantId", "statement", "criticality", "requiredEvidenceClasses", "verificationModes", "acceptanceCriteria", "version"],
  "properties": {
    "requirementId": { "type": "string", "minLength": 1 },
    "tenantId": { "type": "string", "minLength": 1 },
    "statement": { "type": "string", "minLength": 1 },
    "criticality": { "enum": ["LOW", "MEDIUM", "HIGH", "SAFETY_CRITICAL"] },
    "requiredEvidenceClasses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["SIMULATED", "COMPUTED", "MEASURED", "OBSERVED", "ATTESTED", "INFERRED", "ESTIMATED"] } },
    "verificationModes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["TEST", "FORMAL", "REVIEW", "MEASUREMENT", "SIMULATION"] } },
    "acceptanceCriteria": { "type": "object" },
    "version": { "type": "string", "minLength": 1 }
  }
}
