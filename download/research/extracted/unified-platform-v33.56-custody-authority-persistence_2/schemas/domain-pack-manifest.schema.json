{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sovereign-foundry.example/schemas/domain-pack-manifest.v1.json",
  "title": "Domain Pack Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["packId", "version", "kernelContractVersion", "ontologyVersion", "workflows", "requiredCapabilities", "emittedEvidenceClasses", "requiredScopes", "uiSurfaces", "risks", "authorityModel"],
  "properties": {
    "packId": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "kernelContractVersion": { "type": "string", "minLength": 1 },
    "ontologyVersion": { "type": "string", "minLength": 1 },
    "workflows": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "requiredCapabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "emittedEvidenceClasses": { "type": "array", "uniqueItems": true, "items": { "enum": ["SIMULATED", "COMPUTED", "MEASURED", "OBSERVED", "ATTESTED", "INFERRED", "ESTIMATED"] } },
    "requiredScopes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "not": { "pattern": "(^\\*$|\\.\\*$)" } } },
    "uiSurfaces": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "risks": { "type": "array", "items": { "type": "string" } },
    "authorityModel": { "const": "canonical-kernel-only" }
  }
}
