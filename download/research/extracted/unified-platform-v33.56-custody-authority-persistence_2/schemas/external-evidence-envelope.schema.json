{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sovereign-foundry.invalid/schemas/external-evidence-envelope.schema.json",
  "title": "External Qualification Evidence Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidenceId", "gateId", "sourceDigest", "artifactDigest", "producedAt", "environmentId", "collectorId", "independentReviewerId", "evidenceClass", "signature"],
  "properties": {
    "evidenceId": { "type": "string", "minLength": 1 },
    "gateId": { "type": "string", "minLength": 1 },
    "sourceDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifactDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "producedAt": { "type": "string", "format": "date-time" },
    "environmentId": { "type": "string", "minLength": 1 },
    "collectorId": { "type": "string", "minLength": 1 },
    "independentReviewerId": { "type": "string", "minLength": 1 },
    "evidenceClass": { "const": "OBSERVED" },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyId", "algorithm", "verified"],
      "properties": {
        "keyId": { "type": "string", "minLength": 1 },
        "algorithm": { "enum": ["Ed25519", "ECDSA_P256_SHA256", "RSA_PSS_SHA256"] },
        "verified": { "const": true }
      }
    }
  }
}
