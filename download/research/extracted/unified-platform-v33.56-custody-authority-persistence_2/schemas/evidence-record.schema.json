{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sovereign-foundry.local/schemas/evidence-record-v0.1.json",
  "title": "EvidenceRecord v0.1",
  "type": "object",
  "required": ["recordId", "tenantId", "kind", "subject", "payload", "evidenceClass", "method", "environment", "createdAt", "limitations"],
  "properties": {
    "recordId": {"type": "string", "minLength": 1},
    "tenantId": {"type": "string", "minLength": 1},
    "kind": {"type": "string", "minLength": 1},
    "subject": {"type": "string", "minLength": 1},
    "payload": {"type": "object"},
    "evidenceClass": {"enum": ["SIMULATED", "COMPUTED", "MEASURED", "OBSERVED", "ATTESTED"]},
    "method": {"type": "string", "minLength": 1},
    "environment": {"type": "object"},
    "createdAt": {"type": "string", "format": "date-time"},
    "previousDigest": {"type": "string"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
