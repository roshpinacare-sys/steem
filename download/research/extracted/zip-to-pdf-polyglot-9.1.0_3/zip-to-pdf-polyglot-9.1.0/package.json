{
  "name": "zip-to-pdf-polyglot",
  "version": "9.1.0",
  "description": "ZIP↔PDF polyglot builder — the file that is simultaneously a valid PDF and a valid ZIP. 10 strategies including AES-256-GCM, ChaCha20-Poly1305, RSA-2048.",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "zip2pdf": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx cli.ts",
    "serve": "tsx server/index.ts",
    "mcp": "tsx mcp-server/index.ts",
    "test": "npx tsx test/basic.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "pdf", "zip", "polyglot", "steganography",
    "aes-gcm", "chacha20-poly1305", "rsa",
    "mcp", "agent", "module-os"
  ],
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
