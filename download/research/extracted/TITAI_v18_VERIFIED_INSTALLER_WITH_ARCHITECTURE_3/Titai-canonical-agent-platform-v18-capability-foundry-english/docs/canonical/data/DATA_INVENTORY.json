{
  "schemaVersion": 1,
  "defaultResidency": "local application database unless an explicitly configured provider receives request content",
  "classes": [
    {
      "id": "identity",
      "stores": [
        "users"
      ],
      "sensitivity": "confidential",
      "owner": "user",
      "purpose": "authentication and preferences",
      "retention": "account lifetime",
      "export": "required",
      "correction": "required",
      "deletion": "cascade account data subject to audit policy"
    },
    {
      "id": "provider-secret",
      "stores": [
        "provider_configs.apiKeyCiphertext",
        "provider_configs.apiKeyIv",
        "provider_configs.apiKeyTag"
      ],
      "sensitivity": "restricted",
      "owner": "user",
      "purpose": "optional provider access",
      "retention": "until removed or account deletion",
      "export": "never export plaintext",
      "correction": "replace only",
      "deletion": "secure logical deletion required"
    },
    {
      "id": "agent-definition",
      "stores": [
        "agents",
        "agent_versions",
        "agent_skills"
      ],
      "sensitivity": "confidential",
      "owner": "user",
      "purpose": "versioned delegated behavior",
      "retention": "until deletion or archive policy",
      "export": "required",
      "correction": "new immutable version",
      "deletion": "cascade with explicit confirmation"
    },
    {
      "id": "skill-definition",
      "stores": [
        "skills",
        "skill_versions"
      ],
      "sensitivity": "internal",
      "owner": "user or platform",
      "purpose": "reusable instructions",
      "retention": "version history",
      "export": "required",
      "correction": "new immutable version",
      "deletion": "owner controlled unless built-in"
    },
    {
      "id": "run-content",
      "stores": [
        "runs",
        "run_steps",
        "run_events"
      ],
      "sensitivity": "confidential",
      "owner": "user",
      "purpose": "execution and reconstruction",
      "retention": "configurable; currently undefined",
      "export": "required",
      "correction": "append-only correction event preferred",
      "deletion": "must include derived artifacts and indexes"
    },
    {
      "id": "approval",
      "stores": [
        "approvals"
      ],
      "sensitivity": "confidential",
      "owner": "user",
      "purpose": "human authority record",
      "retention": "at least run retention",
      "export": "required",
      "correction": "append audit correction; do not rewrite decision silently",
      "deletion": "inherit run and records policy"
    },
    {
      "id": "artifact",
      "stores": [
        "artifacts"
      ],
      "sensitivity": "inherits run",
      "owner": "user",
      "purpose": "run output",
      "retention": "inherits run unless pinned",
      "export": "required",
      "correction": "new artifact version",
      "deletion": "cascade with run"
    },
    {
      "id": "audit",
      "stores": [
        "audit_log"
      ],
      "sensitivity": "confidential",
      "owner": "platform and user",
      "purpose": "tamper-evident accountability",
      "retention": "policy not yet defined",
      "export": "required with redaction",
      "correction": "append-only",
      "deletion": "requires explicit legal and operational policy"
    },
    {
      "id": "policy",
      "stores": [
        "policies"
      ],
      "sensitivity": "internal",
      "owner": "platform administrator",
      "purpose": "execution authorization",
      "retention": "versioning not yet implemented",
      "export": "required",
      "correction": "versioned change preferred",
      "deletion": "must preserve effective-history evidence"
    },
    {
      "id": "template",
      "stores": [
        "templates"
      ],
      "sensitivity": "internal",
      "owner": "user or platform",
      "purpose": "reusable launch configuration",
      "retention": "until deletion",
      "export": "required",
      "correction": "replace or version",
      "deletion": "owner controlled"
    },
    {
      "id": "governed-memory",
      "stores": [
        "memories"
      ],
      "sensitivity": "public, internal, or restricted per record",
      "owner": "user",
      "purpose": "provenance-aware reusable context with correction and expiry",
      "retention": "record expiry or explicit owner deletion; account deletion cascades",
      "export": "included in user export",
      "correction": "replacement record linked through corrects_id; prior record becomes corrected",
      "deletion": "hard delete by owner; account deletion cascades; audit content stores hashes only"
    }
  ],
  "openRequirements": [
    "Define configurable retention periods.",
    "Implement deletion propagation to logs, backups, caches, and future vector indexes.",
    "Define audit retention and redaction policy.",
    "Define backup encryption and restore validation.",
    "Integrate governed memory retrieval into agent execution only after poisoning and isolation integration tests pass."
  ]
}
