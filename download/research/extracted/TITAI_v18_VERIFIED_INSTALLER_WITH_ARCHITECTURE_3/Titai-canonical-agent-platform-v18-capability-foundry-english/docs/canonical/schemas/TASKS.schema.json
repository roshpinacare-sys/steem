{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Titai Canonical Tasks",
  "type": "object",
  "required": [
    "schemaVersion",
    "tasks"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "workstream",
          "priority",
          "status",
          "dependsOn",
          "adrRefs",
          "claimRefs",
          "scope",
          "acceptance",
          "evidenceRequired",
          "rollback",
          "risks",
          "outOfScope"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z0-9]+-[0-9]{3}$"
          },
          "title": {
            "type": "string",
            "minLength": 8
          },
          "workstream": {
            "type": "string"
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "status": {
            "enum": [
              "proposed",
              "ready",
              "in_progress",
              "implemented",
              "verified",
              "done",
              "blocked",
              "rejected"
            ]
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "adrRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "claimRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scope": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "evidenceRequired": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "rollback": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "risks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "outOfScope": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "blockedReason": {
            "type": "string"
          }
        }
      }
    }
  }
}
