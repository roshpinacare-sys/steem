# ─── Core ────────────────────────────────────────────────────────────────
# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-random-secret"

# Encryption key for provider API keys at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY="replace-me-with-a-32-byte-base64-key"

# SQLite database file (default: ./data/titai.db).
# For Turso/libSQL set DATABASE_URL instead (see docs/DEPLOY.md).
DATABASE_PATH="./data/titai.db"

# ─── Optional: default provider keys ─────────────────────────────────────
# Users normally add keys in Settings (encrypted at rest). These env vars are
# only fallbacks for local dev / CI. The app works fully with NONE of them set
# (deterministic simulation mode).
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""
# GOOGLE_API_KEY=""
# OPENROUTER_API_KEY=""
# OLLAMA_BASE_URL="http://localhost:11434/v1"

# Security-sensitive deployment controls
ALLOW_PUBLIC_REGISTRATION=false
# REGISTRATION_INVITE_TOKEN=replace-with-a-long-random-token
TRUST_PROXY_HEADERS=false
TITAI_DURABLE_STORE=sqlite
# Destructive demo seed is disabled unless both variables are explicitly set.
# TITAI_ALLOW_DESTRUCTIVE_SEED=1
# TITAI_DEMO_PASSWORD=replace-with-at-least-12-characters

# Disable anonymous framework telemetry in local and CI builds.
NEXT_TELEMETRY_DISABLED=1

# Encrypted application database backup and restore.
# Keep the passphrase outside the backup file and outside source control.
# TITAI_BACKUP_PASSPHRASE=replace-with-a-long-unique-passphrase
# TITAI_BACKUP_PATH=./backups/titai.backup
# TITAI_RESTORE_OVERWRITE=0
